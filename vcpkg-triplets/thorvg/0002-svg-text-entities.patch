+static void _svgLoaderParserText(SvgParserContext* ctx, const char* content, unsigned int length, bool decode)
 {
     auto& text = ctx->parser->node->node.text;
+
+    //CDATA sections are literal by definition, so only parsed character data
+    //goes through entity expansion.
+    if (decode) {
+        unsigned int decodedLength = 0;
+        if (auto decoded = _decodeXmlEntities(content, length, &decodedLength)) {
+            text.text = append(text.text, decoded, decodedLength);
+            tvg::free(decoded);
+            return;
+        }
+    }
     text.text = append(text.text, content, length);
 }
 
