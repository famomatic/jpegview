+
+//font-family is quoted in CSS ('Arial'); the raw attribute form is not.
+static void _handleFontFamilyAttr(TVG_UNUSED SvgParserContext* ctx, SvgNode* node, const char* value)
+{
+    auto len = value ? strlen(value) : 0;
+    if (len == 0) return;
+
+    node->style->flags |= SvgStyleFlags::FontFamily;
+
+    char* name;
+    auto quote = value[0];
+    if (len >= 2 && (quote == '\'' || quote == '"') && value[len - 1] == quote) {
+        name = duplicate(value + 1, len - 2);
+    } else name = duplicate(value);
+    if (!name) return;
+
+    tvg::free(node->style->fontFamily);
+    node->style->fontFamily = name;
+
+    //A text node carries its own font; apply it directly so the builder picks it up.
+    if (node->type == SvgNodeType::Text || node->type == SvgNodeType::Tspan) {
+        svgUtilReplace(&node->node.text.fontFamily, node->style->fontFamily);
+    }
+}
+
+
+static void _handleFontSizeAttr(SvgParserContext* ctx, SvgNode* node, const char* value)
+{
+    node->style->flags |= SvgStyleFlags::FontSize;
+    node->style->fontSize = _toFontSize(ctx->parser, value);
+
+    if (node->type == SvgNodeType::Text || node->type == SvgNodeType::Tspan) {
+        node->node.text.fontSize = node->style->fontSize;
+    }
+}
