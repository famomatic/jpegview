 static void _updateStyle(SvgNode* node, SvgStyleProperty* parentStyle)
 {
     _styleInherit(node->style, parentStyle);
+
+    //A font inherited from an ancestor group reaches the node only here, after
+    //the cascade has run; a font set on the node itself is already in place.
+    if (node->type == SvgNodeType::Text || node->type == SvgNodeType::Tspan) {
+        if (node->style->fontFamily && !node->node.text.fontFamily) {
